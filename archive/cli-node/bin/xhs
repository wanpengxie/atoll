#!/usr/bin/env node
// xhs CLI shim (M1.1-T3 §7.1.5)
//
// Default behavior: spawn the coagent-xhs Go binary built by xhs-cli/ and
// pass through stdin/stdout/stderr/exit code. Env COAGENT_XHS_BACKEND is
// auto-set to "real" when COAGENT_DAEMON_HTTP is configured (so the agent's
// channel-spawned shell goes through daemon RPC), otherwise "mock".
//
// Fallback: COAGENT_XHS_PROVIDER=ts-mock loads the legacy ts mock CLI
// (cli/dist/index.js → runXhs) — kept for debugging and tests that don't
// require the Go binary or daemon to be live.
//
// Binary resolution order:
//   1. env COAGENT_XHS_BIN (explicit absolute or PATH-resolvable name)
//   2. <repo-root>/xhs-cli/bin/coagent-xhs (built via `go build -o bin/coagent-xhs ./cmd/coagent-xhs`)
//   3. PATH lookup `coagent-xhs`

import { spawnSync } from 'node:child_process';
import { existsSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { importDistEntry } from './lib/dist-entry.js';

export const COAGENT_XHS_BINARY = 'coagent-xhs';

export function repoRootFromBinDir(binDir) {
  // cli/bin → cli → <repo-root>
  return path.resolve(binDir, '..', '..');
}

export function findOnPath(name, env = process.env) {
  const PATH = env.PATH ?? env.Path ?? env.path ?? '';
  if (!PATH) return null;
  const exts = process.platform === 'win32'
    ? (env.PATHEXT ?? '.EXE;.CMD;.BAT;.COM').split(';')
    : [''];
  for (const dir of PATH.split(path.delimiter)) {
    if (!dir) continue;
    for (const ext of exts) {
      const candidate = path.join(dir, name + ext);
      if (existsSync(candidate)) return candidate;
    }
  }
  return null;
}

export function resolveCoagentXhsBinary({ binDir, env = process.env } = {}) {
  const explicit = env.COAGENT_XHS_BIN?.trim();
  if (explicit) {
    if (path.isAbsolute(explicit)) {
      if (existsSync(explicit)) return { path: explicit, source: 'env_absolute' };
      return { path: null, source: 'env_absolute', missing: explicit };
    }
    // Relative env value: try resolving against PATH first, then against repo
    const onPath = findOnPath(explicit, env);
    if (onPath) return { path: onPath, source: 'env_path' };
    return { path: null, source: 'env_path', missing: explicit };
  }

  const repoRoot = repoRootFromBinDir(binDir);
  const repoBin = path.join(repoRoot, 'xhs-cli', 'bin', COAGENT_XHS_BINARY);
  if (existsSync(repoBin)) return { path: repoBin, source: 'repo_bin' };

  const onPath = findOnPath(COAGENT_XHS_BINARY, env);
  if (onPath) return { path: onPath, source: 'path' };

  return { path: null, source: 'not_found' };
}

export function inferDefaultBackend(env = process.env) {
  if (env.COAGENT_XHS_BACKEND?.trim()) return env.COAGENT_XHS_BACKEND.trim();
  return env.COAGENT_DAEMON_HTTP?.trim() ? 'real' : 'mock';
}

export function buildSpawnEnv(baseEnv = process.env) {
  const env = { ...baseEnv };
  env.COAGENT_XHS_BACKEND = inferDefaultBackend(baseEnv);
  return env;
}

export async function runTsMockFallback({ binDir, args }) {
  const mod = await importDistEntry({
    binDir,
    relativeDistPath: '../dist/index.js',
    packageName: '@coagent/cli',
    buildCommand: 'pnpm --filter @coagent/cli build',
  });
  if (mod === false) {
    process.exit(process.exitCode ?? 1);
  }
  if (typeof mod?.runXhs === 'function') {
    await mod.runXhs(args);
    return;
  }
  if (typeof mod?.main === 'function') {
    await mod.main(args);
    return;
  }
  process.stderr.write('xhs ts-mock fallback: dist/index.js exposes neither runXhs nor main\n');
  process.exit(1);
}

export async function runShim({ binDir, args, env = process.env, spawnImpl = spawnSync } = {}) {
  if (env.COAGENT_XHS_PROVIDER?.trim() === 'ts-mock') {
    await runTsMockFallback({ binDir, args });
    return;
  }
  const resolved = resolveCoagentXhsBinary({ binDir, env });
  if (!resolved.path) {
    const tried = resolved.source === 'env_absolute' || resolved.source === 'env_path'
      ? `COAGENT_XHS_BIN=${resolved.missing}`
      : `<repo>/xhs-cli/bin/${COAGENT_XHS_BINARY} or ${COAGENT_XHS_BINARY} on PATH`;
    process.stderr.write(
      `xhs shim: cannot locate coagent-xhs binary (${tried})\n`
      + 'Build it via: go build -o xhs-cli/bin/coagent-xhs ./xhs-cli/cmd/coagent-xhs\n'
      + 'Or set COAGENT_XHS_BIN to an absolute path.\n'
      + 'Or set COAGENT_XHS_PROVIDER=ts-mock for the ts mock fallback.\n',
    );
    process.exit(1);
  }
  const spawnEnv = buildSpawnEnv(env);
  const result = spawnImpl(resolved.path, args, {
    stdio: 'inherit',
    env: spawnEnv,
  });
  if (result.error) {
    process.stderr.write(`xhs shim: failed to spawn ${resolved.path}: ${result.error.message}\n`);
    process.exit(1);
  }
  if (result.signal) {
    process.exit(1);
  }
  process.exit(result.status ?? 0);
}

const isCli = (() => {
  try {
    return import.meta.url === `file://${process.argv[1]}`
      || fileURLToPath(import.meta.url) === process.argv[1];
  } catch {
    return false;
  }
})();

if (isCli) {
  const here = path.dirname(fileURLToPath(import.meta.url));
  await runShim({ binDir: here, args: process.argv.slice(2) });
}
