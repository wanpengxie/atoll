# ui/.env.example — vite build-time env for the coagent demo console.
#
# Copy to .env.local (gitignored) and fill in your values; vite picks
# them up automatically and replaces `import.meta.env.VITE_*` at build
# time. See https://vitejs.dev/guide/env-and-mode.html for the lookup
# precedence.
#
# M1.6-T7 phase-3 — the COAGENT_* env names mirror the canonical knobs
# used by cmd/server / cmd/daemon / wxt.config.ts so a single .env at
# the deploy root drives the whole stack. vite.config.js forwards
# COAGENT_* into the VITE_*-prefixed names that the client bundle reads.

# Chrome extension id used by the "Bind Chrome extension" button.
#
# Dev:  load the unpacked extension at `pnpm -C adapters/device/xhs/extension/app/chrome-extension dev`
#       and copy the 32-char id Chrome shows on chrome://extensions.
#       If you set COAGENT_EXTENSION_KEY / COAGENT_EXTENSION_KEY_FILE
#       when building the extension, the id stays stable across reloads
#       and you can pin it here once.
# Prod: the Chrome Web Store-assigned id (32 lowercase a-p chars).
#
# Either name works — COAGENT_EXTENSION_ID is the canonical project-wide
# knob; VITE_COAGENT_EXTENSION_ID is the legacy form kept for backwards
# compat. Leave both empty to disable the bind button (the UI degrades
# gracefully with a "VITE_COAGENT_EXTENSION_ID not configured" hint).
COAGENT_EXTENSION_ID=
# VITE_COAGENT_EXTENSION_ID=

# Vite dev-server proxy target. Defaults to http://localhost:8080 if
# unset; only override when running the coagent server on a non-default
# host / port.
# COAGENT_SERVER_URL=http://localhost:8080
# VITE_SERVER_URL=http://localhost:8080
