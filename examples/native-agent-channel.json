{
  "id": "native-agent-channel",
  "name": "native-agent-channel",
  "visibility": "public",
  "body": {
    "declarations": [
      {
        "config": {
          "llm_actor": "pi-llm",
          "loopers": [
            "agent-looper"
          ],
          "max_assignments_per_looper": 32,
          "max_inputs_per_work": 128,
          "max_open_works": 32,
          "max_operation_keys": 256,
          "max_turns": 12,
          "default_model": "deepseek/deepseek-v4-pro",
          "tool_image_max_bytes": 3145728,
          "tool_result_max_bytes": 51200,
          "tool_result_max_lines": 2000
        },
        "decl_id": "native-agent"
      },
      {
        "decl_id": "agent-looper",
        "config": {
          "llm_actor": "pi-llm",
          "max_assignments": 32
        },
        "bindings": {
          "host_channel": "parent_channel_id"
        }
      },
      {
        "decl_id": "agent-main",
        "config": {
          "llm_actor": "pi-llm",
          "model": "deepseek/deepseek-v4-pro",
          "session": "main"
        }
      },
      {
        "decl_id": "pi-llm"
      },
      {
        "config": {
          "max_concurrency": 4,
          "node": "node",
          "queue_capacity": 32
        },
        "decl_id": "pi-workspace"
      },
      {
        "decl_id": "native-agent-handle",
        "bindings": {
          "host": "parent_channel_id"
        }
      }
    ],
    "profile": {
      "default_storage_device_id": "local-device",
      "description": "Channel-native Pi Agent using a configurable Pi LLM provider and Pi base workspace tools.",
      "serving": 0
    },
    "type": "actor"
  }
}
