{
  "class": "channel-handle",
  "config": {
    "drivers": [
      "native-agent",
      "agent-looper",
      "agent-main"
    ],
    "host": "c0",
    "words": {
      "agent.ask": {
        "description": "Submit work in _context.session. Use the standard session=new parameter to fork a new branch. Receipt mode requires submission_key.",
        "schema": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "attachments": {
              "type": "array"
            },
            "origin": {
              "type": "object",
              "required": [
                "session"
              ],
              "properties": {
                "session": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "delivery": {
              "enum": [
                "wait",
                "receipt"
              ]
            },
            "submission_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "related_work_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "delivery": {
                    "const": "receipt"
                  }
                },
                "required": [
                  "delivery"
                ]
              },
              "then": {
                "required": [
                  "submission_key"
                ]
              }
            }
          ],
          "additionalProperties": false
        },
        "target": "native-agent"
      },
      "agent.hold": {
        "description": "Freeze one view for up to 30 minutes. Holding its current owner first interrupts and then requeues it for editing; effects are not rolled back.",
        "schema": {
          "additionalProperties": false,
          "properties": {
            "duration_ms": {
              "maximum": 1800000,
              "minimum": 1,
              "type": "integer"
            },
            "target": {
              "type": "string"
            },
            "work_id": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "target": "native-agent"
      },
      "agent.interrupt": {
        "description": "Request stop for one work. The empty form stops caller-visible open work Agent-wide; never use it as a fallback after a targeted failure. operation_key is supported only with work_id.",
        "schema": {
          "type": "object",
          "properties": {
            "work_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "operation_key": {
              "type": "string",
              "maxLength": 256
            }
          },
          "additionalProperties": false
        },
        "target": "native-agent"
      },
      "agent.main.merge": {
        "description": "Manage the main session branch relation.",
        "schema": {
          "type": "object",
          "required": [
            "from_session"
          ],
          "properties": {
            "from_session": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "target": "agent-main"
      },
      "agent.main.merge_all": {
        "description": "Manage the main session branch relation.",
        "schema": {
          "type": "object",
          "additionalProperties": false
        },
        "target": "agent-main"
      },
      "agent.main.track": {
        "description": "Manage the main session branch relation.",
        "schema": {
          "type": "object",
          "required": [
            "from_session",
            "merge"
          ],
          "properties": {
            "from_session": {
              "type": "string"
            },
            "merge": {
              "enum": [
                "auto",
                "manual",
                "never"
              ]
            }
          },
          "additionalProperties": false
        },
        "target": "agent-main"
      },
      "agent.replace": {
        "description": "Replace a waiting target using old_text CAS; the replacement retains its sender identity and queue position.",
        "schema": {
          "additionalProperties": false,
          "properties": {
            "new_text": {
              "type": "string"
            },
            "old_text": {
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "work_id": {
              "type": "string"
            }
          },
          "required": [
            "target",
            "old_text",
            "new_text"
          ],
          "type": "object"
        },
        "target": "native-agent"
      },
      "agent.result": {
        "description": "Read one durable work result. state=open is not a successful empty result: follow the returned agent.result request later, or use the returned targeted interrupt request.",
        "schema": {
          "type": "object",
          "required": [
            "work_id"
          ],
          "properties": {
            "work_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "additionalProperties": false
        },
        "target": "native-agent"
      },
      "agent.session.archive": {
        "description": "Read or change session lifecycle state.",
        "schema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "from_session": {
              "type": "string"
            },
            "through": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "target": "native-agent"
      },
      "agent.session.get": {
        "description": "Read or change session lifecycle state.",
        "schema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "from_session": {
              "type": "string"
            },
            "through": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "target": "native-agent"
      },
      "agent.session.list": {
        "description": "Read or change session lifecycle state.",
        "schema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "from_session": {
              "type": "string"
            },
            "through": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "target": "native-agent"
      },
      "agent.session.rename": {
        "description": "Read or change session lifecycle state.",
        "schema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "from_session": {
              "type": "string"
            },
            "through": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "target": "native-agent"
      },
      "agent.session.reset": {
        "description": "Read or change session lifecycle state.",
        "schema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "from_session": {
              "type": "string"
            },
            "through": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "target": "native-agent"
      },
      "agent.session.sync": {
        "description": "Read or change session lifecycle state.",
        "schema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "from_session": {
              "type": "string"
            },
            "through": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "target": "native-agent"
      },
      "agent.status": {
        "description": "Inspect or page caller-visible works without driving, retrying, or changing them. Selected status exposes each input's accepted/assigned/included disposition without repeating its body. Use submission_key to recover a lost cross-channel receipt; follow the opaque stable next_cursor and actor-authored next[].",
        "schema": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "cursor": {
                  "type": "string"
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "work_id"
              ],
              "properties": {
                "work_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "submission_key"
              ],
              "properties": {
                "submission_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "target": "native-agent"
      },
      "agent.steer": {
        "description": "Steer text or waiting target into one view's execution; all gathers only the caller's waiting requests in that view. Acceptance is confirmed by the execution; included=false is not model consumption. expected_turn_id is a compare-and-swap guard.",
        "schema": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "text"
              ],
              "properties": {
                "work_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "operation_key": {
                  "type": "string",
                  "maxLength": 256
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "expected_turn_id": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "target"
              ],
              "properties": {
                "work_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "operation_key": {
                  "type": "string",
                  "maxLength": 256
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "all"
              ],
              "properties": {
                "work_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "operation_key": {
                  "type": "string",
                  "maxLength": 256
                },
                "all": {
                  "const": true
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "target": "native-agent"
      },
      "agent.unhold": {
        "description": "Release a view's hold, restoring any prior interrupt freeze.",
        "schema": {
          "additionalProperties": false,
          "properties": {
            "work_id": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "target": "native-agent"
      },
      "agent.options": {
        "description": "Return available models and current selection.",
        "schema": {
          "type": "object",
          "additionalProperties": false
        },
        "target": "native-agent"
      },
      "agent.select": {
        "description": "Select model and thinking effort.",
        "schema": {
          "type": "object",
          "required": [
            "model"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "target": "native-agent"
      }
    }
  },
  "id": "native-agent-handle",
  "name": "host",
  "visibility": "public"
}
