dist/
# go build output binaries
/bin/
bin/
*.local.*
.logs/
.env
.coagent-local/
.dalek/
.dev-secrets/
/.cache/
*.err.log
output/*

# web/dist is where a UI build lands, and it is nobody's source: everything in
# it is ignored. The one tracked file is .gitkeep — an anchor so `//go:embed
# all:dist` still compiles in a fresh checkout. It carries no content and no
# build writes it, so `make web` never shows up as a diff and nobody can
# "restore" a built UI away. The page shown when no UI was built lives in
# web/placeholder/, out of the build's reach. The blanket `dist/` rule above
# would take the directory whole, so it is re-opened here.
!/web/dist/
/web/dist/*
!/web/dist/.gitkeep
